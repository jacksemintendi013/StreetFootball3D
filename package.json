{
  "name": "StreetFootball3D",
  "version": "0.0.1",
  "description": "A realistic open-world football game inspired by FIFA Street for mobile and PC",
  "main": "index.js",
  "scripts": {
    "build": "unity -batchmode -buildWindows64Player",
    "build:mobile": "unity -batchmode -buildAndroidPlayer",
